---
import { Icon } from "astro-icon/components";
import { moments } from "../data/moments";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
---
<MainGridLayout title="碎碎念" description="平时写代码、折腾服务器和追番时的短动态记录。">
	<div class="flex flex-col gap-4 w-full">
		<div class="card-base overflow-hidden">
			<div class="win-chrome">
				<div class="flex items-center gap-2 min-w-0">
					<span class="win-dots win-dots-vivid" aria-hidden="true"><span></span><span></span><span></span></span>
					<span class="font-mono-tech text-[0.68rem] text-50 truncate">~/moments</span>
				</div>
				<span class="font-mono-tech text-[0.64rem] text-50 shrink-0">{moments.length} NOTES</span>
			</div>
			<div class="px-5 md:px-7 py-5">
				<p class="text-sm text-75 leading-relaxed">
					不想写长文章的时候，就在这里随手记几句折腾记录、追番吐槽和近况。
				</p>
			</div>
		</div>

		<div class="relative flex flex-col gap-3.5">
			{moments.map((m) => (
				<article class="card-base p-5 md:p-6 transition hover:border-[var(--primary)]/35">
					<div class="flex items-center justify-between gap-2 mb-2.5">
						<span class="inline-flex items-center gap-1.5 font-mono-tech text-xs text-50">
							<Icon name="material-symbols:calendar-today-outline-rounded" class="text-sm text-[var(--primary)]" />
							{m.date}
						</span>
						<span class="pill-tag">
							<span class="pill-tag-prefix">#</span>
							<span class="pill-tag-label">{m.tag}</span>
						</span>
					</div>
					<p class="text-[0.94rem] text-90 leading-relaxed whitespace-pre-line">
						{m.content}
					</p>
					{m.link && (
						<div class="mt-3">
							<a
								href={m.link.href.startsWith("http") ? m.link.href : url(m.link.href)}
								target={m.link.href.startsWith("http") ? "_blank" : undefined}
								rel={m.link.href.startsWith("http") ? "noopener noreferrer" : undefined}
								class="inline-flex items-center gap-1 font-mono-tech text-xs text-[var(--primary)] hover:underline"
							>
								<span>{m.link.label}</span>
								<Icon name="material-symbols:arrow-forward-rounded" class="text-sm" />
							</a>
						</div>
					)}
				</article>
			))}
		</div>
	</div>
</MainGridLayout>

---
import { Icon } from "astro-icon/components";
import {
	gameList,
	musicList,
	neteasePlaylistId,
	toolList,
} from "../data/collection";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---
<MainGridLayout title="收藏" description="常听歌单、在玩的游戏，以及日常主力软件与开发工具清单。">
	<div class="flex flex-col gap-4 w-full">
		<!-- Music / Vinyl Wall -->
		<section class="card-base overflow-hidden">
			<div class="win-chrome">
				<div class="flex items-center gap-2 min-w-0">
					<span class="win-dots win-dots-vivid" aria-hidden="true"><span></span><span></span><span></span></span>
					<span class="font-mono-tech text-[0.68rem] text-50 truncate">~/collection/music</span>
				</div>
				<span class="font-mono-tech text-[0.64rem] text-50 shrink-0">{musicList.length} TRACKS</span>
			</div>
			<div class="p-5 md:p-6 flex flex-col gap-4">
				{neteasePlaylistId && (
					<div class="rounded-xl overflow-hidden border border-[var(--card-border)] bg-black/[0.02] dark:bg-white/[0.02]">
						<iframe
							title="网易云音乐歌单"
							class="w-full h-[210px] border-0"
							src={`https://music.163.com/outchain/player?type=0&id=${neteasePlaylistId}&auto=0&height=190`}
						></iframe>
					</div>
				)}
				<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
					{musicList.map((track) => (
						<a
							href={track.url}
							target="_blank"
							rel="noopener noreferrer"
							class="group rounded-xl border border-[var(--card-border)] bg-black/[0.015] dark:bg-white/[0.02] hover:border-[var(--primary)]/45 hover:bg-[var(--btn-plain-bg-hover)] p-4 transition flex items-start gap-3"
						>
							<div class="w-10 h-10 rounded-xl shrink-0 bg-[var(--btn-regular-bg)] text-[var(--primary)] flex items-center justify-center transition-transform duration-300 group-hover:scale-105">
								<Icon name="material-symbols:music-note-rounded" class="text-xl" />
							</div>
							<div class="min-w-0 flex-1">
								<div class="flex items-center justify-between gap-2">
									<div class="font-display font-bold text-sm text-90 group-hover:text-[var(--primary)] truncate transition">
										{track.title}
									</div>
									<Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.65rem] text-50 shrink-0" />
								</div>
								<div class="font-mono-tech text-[0.68rem] text-50 mt-0.5 truncate">
									{track.artist} · {track.tag}
								</div>
								<p class="text-xs text-75 leading-relaxed mt-1.5">{track.note}</p>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- Games -->
		<section class="card-base overflow-hidden">
			<div class="win-chrome">
				<div class="flex items-center gap-2 min-w-0">
					<span class="win-dots text-50" aria-hidden="true"><span></span><span></span><span></span></span>
					<span class="font-mono-tech text-[0.68rem] text-50 truncate">~/collection/games</span>
				</div>
				<span class="font-mono-tech text-[0.64rem] text-50 shrink-0">{gameList.length} GAMES</span>
			</div>
			<div class="p-5 md:p-6 grid grid-cols-1 md:grid-cols-2 gap-3">
				{gameList.map((g) => (
					<div class="rounded-xl border border-[var(--card-border)] bg-black/[0.015] dark:bg-white/[0.02] p-4">
						<div class="flex items-center justify-between gap-2">
							<span class="font-display font-bold text-base text-90">{g.title}</span>
							<span class="font-mono-tech text-[0.66rem] px-2 py-0.5 rounded-md bg-[var(--btn-regular-bg)] text-[var(--primary)]">
								{g.status} · {g.platform}
							</span>
						</div>
						<p class="text-xs text-75 leading-relaxed mt-2">{g.note}</p>
					</div>
				))}
			</div>
		</section>

		<!-- Daily Tools & Uses -->
		<section class="card-base overflow-hidden">
			<div class="win-chrome">
				<div class="flex items-center gap-2 min-w-0">
					<span class="win-dots text-50" aria-hidden="true"><span></span><span></span><span></span></span>
					<span class="font-mono-tech text-[0.68rem] text-50 truncate">~/collection/uses</span>
				</div>
				<span class="font-mono-tech text-[0.64rem] text-50 shrink-0">{toolList.length} TOOLS</span>
			</div>
			<div class="p-5 md:p-6 grid grid-cols-1 md:grid-cols-2 gap-3">
				{toolList.map((tool) => (
					<div class="rounded-xl border border-[var(--card-border)] bg-black/[0.015] dark:bg-white/[0.02] p-4 flex flex-col justify-between gap-2">
						<div>
							<div class="flex items-center justify-between gap-2">
								{tool.url ? (
									<a
										href={tool.url}
										target="_blank"
										rel="noopener noreferrer"
										class="font-display font-bold text-sm text-90 hover:text-[var(--primary)] transition inline-flex items-center gap-1"
									>
										<span>{tool.name}</span>
										<Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.62rem] text-50" />
									</a>
								) : (
									<span class="font-display font-bold text-sm text-90">{tool.name}</span>
								)}
								<span class="font-mono-tech text-[0.65rem] px-2 py-0.5 rounded-md bg-black/[0.04] dark:bg-white/[0.06] text-60">
									{tool.category}
								</span>
							</div>
							<p class="text-xs text-75 leading-relaxed mt-1.5">{tool.desc}</p>
						</div>
					</div>
				))}
			</div>
		</section>
	</div>
</MainGridLayout>

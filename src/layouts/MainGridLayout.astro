---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";
import { pathsEqual, url } from "../utils/url-utils";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;
const showBanner = siteConfig.banner.enable && pathsEqual(Astro.url.pathname, url("/"));
const hasBannerCredit = showBanner && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = showBanner
	? `calc(var(--banner-display-height, var(--banner-height)) - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "6.25rem";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<!-- Reading Progress Bar -->
<div id="reading-progress" class="reading-progress-bar" aria-hidden="true"></div>

<!-- Wide-screen ambient side glow orbs, architectural framing lines & subtle floating glyphs -->
<div class="pointer-events-none fixed inset-0 overflow-hidden z-0" aria-hidden="true">
    <div class="ambient-orb-left hidden lg:block absolute top-[38%] -left-36 w-[28rem] h-[28rem] rounded-full blur-3xl opacity-70 dark:opacity-55"></div>
    <div class="ambient-orb-right hidden lg:block absolute top-[58%] -right-36 w-[26rem] h-[26rem] rounded-full blur-3xl opacity-65 dark:opacity-50"></div>
    <div class="hidden min-[1440px]:block absolute inset-y-0 left-1/2 -translate-x-1/2 w-[calc(var(--page-width)+2.5rem)] border-x border-dashed border-[var(--line-divider)] opacity-80"></div>

    <!-- Subtle drifting margin glyphs on ultra-wide screens -->
    <span class="side-glyph hidden min-[1560px]:block absolute top-[58%] left-[7%] font-mono-tech text-sm text-[var(--primary)]" style="--glyph-dur: 7.5s; --glyph-delay: 0s;">♪</span>
    <span class="side-glyph hidden min-[1560px]:block absolute top-[82%] left-[10%] font-mono-tech text-xs text-50" style="--glyph-dur: 9s; --glyph-delay: 1.8s;">◇</span>
    <span class="side-glyph hidden min-[1560px]:block absolute top-[62%] right-[8%] font-mono-tech text-xs text-[var(--primary)]" style="--glyph-dur: 8.2s; --glyph-delay: 0.9s;">+</span>
    <span class="side-glyph hidden min-[1560px]:block absolute top-[85%] right-[10%] font-mono-tech text-sm text-50" style="--glyph-dur: 10s; --glyph-delay: 2.6s;">♫</span>
</div>

<!-- Left Margin Editorial Spine Rail (wide desktop only) -->
<aside class="pointer-events-none hidden min-[1480px]:flex fixed left-6 top-[70%] -translate-y-1/2 z-20 flex-col items-center gap-3.5 select-none opacity-75 hover:opacity-100 transition-opacity" aria-hidden="true">
    <span class="font-mono-tech text-[0.7rem] text-[var(--primary)] leading-none">+</span>
    <span class="w-px h-8 bg-gradient-to-b from-transparent via-[var(--line-color)] to-[var(--line-color)]"></span>
    <span class="writing-vertical-lr font-mono-tech text-[0.65rem] tracking-[0.26em] uppercase text-50">
        FIELD NOTES // LANNOKAEDE · 2026
    </span>
    <span class="w-px h-8 bg-[var(--line-color)]"></span>
    <div class="flex flex-col items-center gap-1.5">
        <span class="eq-bars"><span></span><span></span><span></span></span>
        <span id="side-scroll-pct" class="font-mono-tech text-[0.65rem] font-semibold text-[var(--primary)]">00%</span>
    </div>
    <span class="font-mono-tech text-[0.7rem] text-30 leading-none">+</span>
</aside>

<!-- Right Margin Coordinates & Vertical Scroll Track (wide desktop, hidden on post pages with TOC) -->
<aside id="right-margin-rail" class="pointer-events-none hidden min-[1480px]:flex fixed right-6 top-[70%] -translate-y-1/2 z-20 flex-col items-center gap-3.5 select-none opacity-75 transition-opacity duration-300" aria-hidden="true">
    <span class="font-mono-tech text-[0.7rem] text-[var(--primary)] leading-none">+</span>
    <div class="relative w-[2px] h-24 rounded-full bg-black/10 dark:bg-white/10 overflow-visible">
        <div id="side-scroll-fill" class="w-full rounded-full bg-[var(--primary)]" style="height: 0%; transition: height 80ms linear;"></div>
        <span id="side-scroll-dot" class="absolute left-1/2 -translate-x-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-[var(--primary)] shadow-[0_0_8px_var(--primary)]" style="top: 0%; transition: top 80ms linear;"></span>
    </div>
    <span class="writing-vertical-rl font-mono-tech text-[0.65rem] tracking-[0.24em] uppercase text-50">
        30.75°N · 103.93°E · CHENGDU
    </span>
    <span class="w-px h-8 bg-gradient-to-b from-[var(--line-color)] to-transparent"></span>
    <span class="font-mono-tech text-[0.7rem] text-30 leading-none">+</span>
</aside>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{showBanner && <div id="banner-wrapper" class="absolute inset-x-0 top-0 z-10 overflow-hidden">
    <ImageWrapper id="banner" class="h-full" src={siteConfig.banner.src}
                  mobileSrc={siteConfig.banner.mobileSrc} position={siteConfig.banner.position} priority />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-black/20"></div>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-black/45 via-transparent to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[var(--page-bg)] via-[var(--page-bg)]/55 to-transparent"></div>
    <div id="banner-hero-copy" class="pointer-events-none absolute inset-x-0 bottom-[4.5rem] md:bottom-16 z-20 will-change-transform">
        <div class="max-w-[var(--page-width)] mx-auto px-5 md:px-7 flex items-end justify-between gap-4">
            <div class="max-w-2xl">
                <div class="hidden sm:flex flex-wrap items-center gap-2 mb-3">
                    <div class="inline-flex items-center gap-2 rounded-full px-3 py-1 border border-white/20 bg-black/40 backdrop-blur-md text-[0.72rem] font-mono-tech tracking-wider text-white/90 uppercase shadow-sm">
                        <span class="eq-bars" aria-hidden="true"><span></span><span></span><span></span></span>
                        <span>ENGINEERING NOTES · GO / AGENT / VPS</span>
                    </div>
                    <div class="hidden md:inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 border border-white/15 bg-black/35 backdrop-blur-md text-[0.7rem] font-mono-tech text-white/80">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-soft-pulse"></span>
                        <span>CHENGDU</span>
                        <span id="hero-clock">--:--:--</span>
                    </div>
                </div>
                <h1 class="font-display text-white text-2xl sm:text-3xl md:text-[2.75rem] leading-[1.15] font-bold tracking-[-0.02em] drop-shadow-[0_4px_18px_rgba(0,0,0,0.45)]">
                    {siteConfig.title}
                </h1>
                {siteConfig.subtitle && (
                    <p class="mt-2 text-white/85 text-sm md:text-[1.02rem] font-normal tracking-wide drop-shadow-[0_2px_10px_rgba(0,0,0,0.45)]">
                        {siteConfig.subtitle}
                    </p>
                )}
            </div>

            <!-- Interactive scroll-down cue on desktop -->
            <button type="button" id="hero-scroll-cue" aria-label="向下浏览文章"
                    class="pointer-events-auto hidden lg:inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 mb-10 border border-white/20 bg-black/40 hover:bg-black/60 backdrop-blur-md text-xs font-mono-tech text-white/85 hover:text-white transition cursor-pointer active:scale-95">
                <span>SCROLL</span>
                <Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-base text-[var(--primary)] animate-bob-y" />
            </button>
        </div>
    </div>
</div>}

<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-3 md:px-4"
        >
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[2.25rem] bg-black/65 hover:bg-black/80 h-7 text-xs", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" headings={headings}></SideBar>

            <main id="swup-container" class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden">
                <div id="content-wrapper" class="onload-animation">
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
    </div>
</div>

<!-- The things that should be under the banner, only the TOC for now -->
<div class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative max-w-[var(--page-width)] mx-auto">
        <!-- TOC component -->
        {siteConfig.toc.enable && <div id="toc-wrapper" class:list={["hidden lg:block transition absolute top-0 -right-[var(--toc-width)] w-[var(--toc-width)] items-center",
            {"toc-hide": showBanner}]}
        >
            <div id="toc-inner-wrapper" class="fixed top-14 w-[var(--toc-width)] h-[calc(100vh_-_20rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full h-full transition-swup-fade ">
                    <div class="h-8 w-full"></div>
                    <TOC headings={headings}></TOC>
                    <div class="h-8 w-full"></div>
                </div>
            </div>
        </div>}

        <!-- #toc needs to exist for Swup to work normally -->
        {!siteConfig.toc.enable && <div id="toc"></div>}
    </div>
</div>

<script>
const RING_CIRCUMFERENCE = 138.23;
const NOW_STATUSES = [
    { label: "build", text: "Go Agent · LibreChat · VPS" },
    { label: "music", text: "結束バンド · After School Tea Time" },
    { label: "base", text: "UESTC · Chengdu · Field Notes" },
];

function prefersReducedMotion() {
    return (
        document.documentElement.classList.contains("reduce-motion") ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
    );
}

function updateScrollEffects() {
    const doc = document.documentElement;
    const scrollTop = window.scrollY || doc.scrollTop;
    const maxScroll = doc.scrollHeight - window.innerHeight;
    const ratio = maxScroll > 0 ? Math.min(1, Math.max(0, scrollTop / maxScroll)) : 0;

    // 1. Reading progress bar (on post pages)
    const bar = document.getElementById("reading-progress");
    if (bar) {
        const isPost = Boolean(document.getElementById("post-container"));
        if (!isPost || maxScroll <= 0) {
            bar.style.opacity = "0";
            bar.style.width = "0%";
        } else {
            bar.style.opacity = scrollTop > 40 ? "1" : "0";
            bar.style.width = `${(ratio * 100).toFixed(1)}%`;
        }
    }

    // 2. Back-to-top SVG circular progress ring
    const ring = document.getElementById("back-to-top-ring");
    if (ring) {
        ring.style.strokeDashoffset = `${(RING_CIRCUMFERENCE * (1 - ratio)).toFixed(2)}`;
    }

    // 2b. Wide-screen margin rails (live scroll % & vertical track; hide right rail when post TOC is active)
    const pctText = document.getElementById("side-scroll-pct");
    if (pctText) {
        pctText.textContent = `${String(Math.round(ratio * 100)).padStart(2, "0")}%`;
    }
    const sideFill = document.getElementById("side-scroll-fill");
    const sideDot = document.getElementById("side-scroll-dot");
    const pctStr = `${(ratio * 100).toFixed(1)}%`;
    if (sideFill) sideFill.style.height = pctStr;
    if (sideDot) sideDot.style.top = pctStr;

    const rightRail = document.getElementById("right-margin-rail");
    if (rightRail) {
        const hasPostToc = Boolean(document.getElementById("post-container")) && Boolean(document.querySelector("#toc a"));
        rightRail.style.opacity = hasPostToc ? "0" : "";
    }

    // 3. Navbar scroll state
    const navbar = document.getElementById("navbar");
    if (navbar) {
        if (scrollTop > 36) navbar.setAttribute("data-scrolled", "true");
        else navbar.removeAttribute("data-scrolled");
    }

    // 4. Gentle Hero Banner Parallax & hero copy fade-out
    const banner = document.getElementById("banner");
    if (banner) {
        if (!prefersReducedMotion() && scrollTop < 700) {
            banner.style.transform = `translate3d(0, ${(scrollTop * 0.2).toFixed(1)}px, 0) scale(1.04)`;
        } else if (prefersReducedMotion()) {
            banner.style.transform = "";
        }
    }
    const heroCopy = document.getElementById("banner-hero-copy");
    if (heroCopy) {
        const heroOpacity = Math.max(0, 1 - scrollTop / 160);
        heroCopy.style.opacity = heroOpacity.toFixed(2);
        if (!prefersReducedMotion()) {
            heroCopy.style.transform = `translate3d(0, ${(-Math.min(scrollTop, 180) * 0.16).toFixed(1)}px, 0)`;
        } else {
            heroCopy.style.transform = "";
        }
    }
}

function updateHeroClock() {
    const el = document.getElementById("hero-clock");
    if (!el) return;
    try {
        el.textContent = new Intl.DateTimeFormat("zh-CN", {
            timeZone: "Asia/Shanghai",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false,
        }).format(new Date());
    } catch {}
}

function syncMotionToggleLabels() {
    const reduced = document.documentElement.classList.contains("reduce-motion");
    document.querySelectorAll<HTMLElement>("[data-motion-label]").forEach((el) => {
        el.textContent = reduced ? "动效：减弱" : "动效：开启";
    });
}

function initScrollReveal() {
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
    if (items.length === 0) return;
    if (prefersReducedMotion() || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("is-visible"));
        return;
    }
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                    observer.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.08, rootMargin: "0px 0px -24px 0px" },
    );
    items.forEach((el) => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight * 0.96) {
            el.classList.add("is-visible");
        } else {
            observer.observe(el);
        }
    });
}

function initInteractiveBindings() {
    initScrollReveal();
    syncMotionToggleLabels();
    updateHeroClock();

    // Hero scroll-down button
    const scrollCue = document.getElementById("hero-scroll-cue");
    if (scrollCue && !(scrollCue as any).__bound) {
        (scrollCue as any).__bound = true;
        scrollCue.addEventListener("click", () => {
            const target = document.getElementById("main-grid");
            if (target) target.scrollIntoView({ behavior: prefersReducedMotion() ? "auto" : "smooth", block: "start" });
        });
    }

    // Interactive NOW BUILDING status switcher
    const nowBtn = document.getElementById("now-terminal-btn");
    if (nowBtn && !(nowBtn as any).__bound) {
        (nowBtn as any).__bound = true;
        let idx = 0;
        nowBtn.addEventListener("click", () => {
            idx = (idx + 1) % NOW_STATUSES.length;
            const labelEl = document.getElementById("now-terminal-label");
            const textEl = document.getElementById("now-terminal-text");
            if (labelEl) labelEl.textContent = NOW_STATUSES[idx].label;
            if (textEl) textEl.textContent = NOW_STATUSES[idx].text;
        });
    }

    // Footer motion toggle buttons (desktop + mobile instances)
    document.querySelectorAll<HTMLElement>("[data-motion-toggle]").forEach((btn) => {
        if ((btn as any).__bound) return;
        (btn as any).__bound = true;
        btn.addEventListener("click", () => {
            const root = document.documentElement;
            const nextReduced = !root.classList.contains("reduce-motion");
            root.classList.toggle("reduce-motion", nextReduced);
            try {
                localStorage.setItem("field-motion", nextReduced ? "reduced" : "full");
            } catch {}
            syncMotionToggleLabels();
            updateScrollEffects();
            if (nextReduced) {
                document.querySelectorAll<HTMLElement>("[data-tilt],[data-magnetic]").forEach((el) => {
                    el.style.transform = "";
                });
            }
        });
    });

    // 3D Micro-Tilt reset on leave
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
        if ((card as any).__tiltBound) return;
        (card as any).__tiltBound = true;
        card.addEventListener("pointerleave", () => {
            card.style.transform = "";
        });
    });

    // Magnetic button reset on leave
    document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((btn) => {
        if ((btn as any).__magBound) return;
        (btn as any).__magBound = true;
        btn.addEventListener("pointerleave", () => {
            btn.style.transform = "";
        });
    });
}

function handlePointerMove(e: PointerEvent) {
    if (e.pointerType !== "mouse" || prefersReducedMotion()) return;
    const rawTarget = e.target as HTMLElement | null;

    // 1. Spotlight + illuminated 1px border rim
    const spot = rawTarget?.closest<HTMLElement>("[data-spotlight]");
    if (spot) {
        const rect = spot.getBoundingClientRect();
        spot.style.setProperty("--mouse-x", `${(e.clientX - rect.left).toFixed(1)}px`);
        spot.style.setProperty("--mouse-y", `${(e.clientY - rect.top).toFixed(1)}px`);
    }

    // 2. Subtle 3D micro-tilt on Bento cards
    const tilt = rawTarget?.closest<HTMLElement>("[data-tilt]");
    if (tilt) {
        const rect = tilt.getBoundingClientRect();
        const nx = (e.clientX - rect.left) / rect.width - 0.5;
        const ny = (e.clientY - rect.top) / rect.height - 0.5;
        const rx = (-ny * 4.2).toFixed(2);
        const ry = (nx * 4.2).toFixed(2);
        tilt.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-4px)`;
    }

    // 3. Magnetic pull on small icon buttons
    const mag = rawTarget?.closest<HTMLElement>("[data-magnetic]");
    if (mag) {
        const rect = mag.getBoundingClientRect();
        const dx = ((e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2)) * 4;
        const dy = ((e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2)) * 4;
        mag.style.transform = `translate3d(${dx.toFixed(1)}px, ${dy.toFixed(1)}px, 0)`;
    }
}

function spawnClickSpark(e: MouseEvent) {
    if (prefersReducedMotion()) return;
    const x = e.clientX;
    const y = e.clientY;
    if (x === 0 && y === 0) return;

    const ring = document.createElement("span");
    ring.className = "click-spark-ring";
    ring.style.left = `${x}px`;
    ring.style.top = `${y}px`;
    document.body.appendChild(ring);
    setTimeout(() => ring.remove(), 500);

    const count = 6;
    for (let i = 0; i < count; i++) {
        const angle = (Math.PI * 2 * i) / count + (Math.random() * 0.4 - 0.2);
        const dist = 16 + Math.random() * 10;
        const dot = document.createElement("span");
        dot.className = "click-spark-dot";
        dot.style.left = `${x}px`;
        dot.style.top = `${y}px`;
        dot.style.setProperty("--dx", `${(Math.cos(angle) * dist).toFixed(1)}px`);
        dot.style.setProperty("--dy", `${(Math.sin(angle) * dist).toFixed(1)}px`);
        document.body.appendChild(dot);
        setTimeout(() => dot.remove(), 540);
    }
}

if (!(window as any).__blogMotionBound) {
    (window as any).__blogMotionBound = true;
    let ticking = false;
    const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
            updateScrollEffects();
            ticking = false;
        });
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    document.addEventListener("pointermove", handlePointerMove, { passive: true });
    document.addEventListener("click", spawnClickSpark, { passive: true });
    window.setInterval(updateHeroClock, 1000);

    const bindSwup = () => {
        window.swup?.hooks.on("page:view", () => {
            requestAnimationFrame(() => {
                initInteractiveBindings();
                updateScrollEffects();
            });
        });
    };
    if (window.swup) bindSwup();
    else document.addEventListener("swup:enable", bindSwup, { once: true });
}
initInteractiveBindings();
updateScrollEffects();
</script>
</Layout>

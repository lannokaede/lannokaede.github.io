---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;

let delay = 0;
const interval = 55;
const isFirstPage = page.currentPage === 1;
const pageOffset = (page.currentPage - 1) * page.size;
---
<div class="flex flex-col gap-5 mb-5">
    {page.data.map((entry: CollectionEntry<"posts">, idx: number) => (
        <PostCard
                entry={entry}
                title={entry.data.title}
                tags={entry.data.tags}
                category={entry.data.category}
                published={entry.data.published}
                updated={entry.data.updated}
                url={getPostUrlBySlug(entry.slug)}
                image={entry.data.image}
                description={entry.data.description}
                draft={entry.data.draft}
                featured={isFirstPage && idx === 0}
                issueNumber={String(pageOffset + idx + 1).padStart(2, "0")}
                class="onload-animation"
                style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
        ></PostCard>
    ))}
</div>

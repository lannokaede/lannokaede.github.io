---
import { url } from "../../utils/url-utils";

const sprites = {
	default: url("/images/chibi/bocchi-default.webp"),
	guitar: url("/images/chibi/bocchi-guitar.webp"),
	happy: url("/images/chibi/bocchi-happy.webp"),
	box: url("/images/chibi/bocchi-box.webp"),
};
---

<div
	id="live2d-bocchi-root"
	class="hidden lg:block fixed left-2 min-[1440px]:left-4 min-[1480px]:left-[4.5rem] bottom-3 z-40 select-none pointer-events-none"
	data-sprite-default={sprites.default}
	data-sprite-guitar={sprites.guitar}
	data-sprite-happy={sprites.happy}
	data-sprite-box={sprites.box}
	aria-label="角落 Q 版波奇"
>
	<!-- Active 2D Chibi Stage -->
	<div id="bocchi-stage" class="bocchi-stage group relative flex flex-col items-start">
		<!-- Speech Bubble -->
		<div
			id="bocchi-bubble"
			role="status"
			aria-live="polite"
			class="bocchi-bubble pointer-events-none opacity-0 translate-y-2 transition-all duration-300 -mb-1 ml-3 max-w-[13.5rem] rounded-xl px-3 py-2 text-xs leading-relaxed"
		>
			<div class="flex items-center gap-1.5 mb-0.5 font-mono-tech text-[0.58rem] tracking-wider uppercase opacity-65">
				<span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
				<span>BOCCHI · 2D</span>
			</div>
			<p id="bocchi-bubble-text" class="text-[0.76rem] font-medium"></p>
		</div>

		<!-- 2D Chibi Sprite Stage -->
		<button
			type="button"
			id="bocchi-canvas-wrap"
			class="bocchi-canvas-wrap pointer-events-auto relative w-[184px] h-[196px] flex items-end justify-center cursor-pointer bg-transparent border-0 p-0 focus:outline-none"
			title="点击切换波奇姿态（常态 / 吉他 / 开心 / 纸箱）"
		>
			<div id="bocchi-tilt-wrap" class="w-full h-full flex items-end justify-center will-change-transform transition-transform duration-200 ease-out">
				<img
					id="bocchi-chibi-img"
					src={sprites.default}
					alt="Q 版后藤一里"
					width="184"
					height="193"
					decoding="async"
					draggable="false"
					class="bocchi-chibi-float block w-[184px] h-auto max-h-[196px] object-contain pointer-events-none drop-shadow-[0_10px_18px_rgba(15,23,42,0.18)] dark:drop-shadow-[0_12px_22px_rgba(0,0,0,0.45)]"
				/>
			</div>
		</button>

		<!-- Mini Control Dock -->
		<div
			id="bocchi-dock"
			class="bocchi-dock pointer-events-auto -mt-1 ml-1 flex items-center gap-1 rounded-xl px-2 py-1 opacity-75 group-hover:opacity-100 focus-within:opacity-100 transition-all duration-200"
		>
			<span class="inline-flex items-center gap-1 pr-1 mr-0.5 border-r border-black/10 dark:border-white/10 font-mono-tech text-[0.62rem] font-semibold text-75">
				<span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
				<span>波奇</span>
			</span>
			<button type="button" data-bocchi-exp="default" class="bocchi-chip is-active" title="常态">常态</button>
			<button type="button" data-bocchi-exp="guitar" class="bocchi-chip" title="抱吉他">吉他</button>
			<button type="button" data-bocchi-exp="happy" class="bocchi-chip" title="开心">开心</button>
			<button type="button" data-bocchi-exp="box" class="bocchi-chip" title="躲进纸箱">纸箱</button>
			<button
				type="button"
				id="bocchi-hide-btn"
				aria-label="收起波奇"
				title="收起波奇"
				class="ml-0.5 inline-flex items-center justify-center w-5 h-5 rounded-md text-[0.72rem] text-50 hover:text-[var(--primary)] hover:bg-black/5 dark:hover:bg-white/10 transition cursor-pointer"
			>
				×
			</button>
		</div>
	</div>

	<!-- Compact Restore Pill (32x32 gutter dot on 1024..1439px, labeled pill on 1440px+) -->
	<button
		type="button"
		id="bocchi-restore-btn"
		class="bocchi-dock pointer-events-auto hidden items-center justify-center gap-1.5 rounded-full w-8 h-8 min-[1440px]:w-auto min-[1440px]:h-auto min-[1440px]:px-3 min-[1440px]:py-1.5 text-xs font-medium text-75 hover:text-[var(--primary)] transition-all duration-200 cursor-pointer active:scale-95"
		aria-label="展开 Q 版波奇"
		title="召唤角落里的 Q 版波奇"
	>
		<span class="w-2 h-2 rounded-full bg-pink-400 animate-soft-pulse"></span>
		<span class="hidden min-[1440px]:inline font-mono-tech text-[0.7rem]">波奇 · 2D</span>
	</button>
</div>

<script>
type PoseKey = "default" | "guitar" | "happy" | "box";

const STORAGE_KEY = "chibi-bocchi-hidden";
const POSE_STORAGE_KEY = "chibi-bocchi-pose";
const GREETED_KEY = "chibi-bocchi-greeted";
const POSE_ORDER: PoseKey[] = ["default", "guitar", "happy", "box"];

const POSE_LINES: Record<PoseKey, string[]> = {
	default: [
		"那个……欢迎来到 lannokaede 的手记……",
		"慢慢看文章就好，不用在意角落里的我……",
		"今天也在认真写代码，没有躲进纸箱里。",
	],
	guitar: [
		"背上吉他就能稍微冷静一点……♪",
		"要听一段结束乐队的 riff 吗？（小声）",
		"音准没问题……应该能顺利弹完。",
	],
	happy: [
		"太好了，今天也没有出什么奇怪的 bug！",
		"写完一篇笔记，感觉状态很不错♪",
		"耶——总算跑通了！",
	],
	box: [
		"社恐能量告急，先钻进纸箱躲一会儿……",
		"里面很安全，看不到我……",
		"完熟芒果箱模式下线中……",
	],
};

function isReducedMotion(): boolean {
	return (
		document.documentElement.classList.contains("reduce-motion") ||
		window.matchMedia("(prefers-reduced-motion: reduce)").matches
	);
}

function initChibiBocchi() {
	const root = document.getElementById("live2d-bocchi-root");
	if (!root || (window as any).__chibiBocchiInit) return;
	if (!window.matchMedia("(min-width: 1024px)").matches) return;

	(window as any).__chibiBocchiInit = true;

	const stage = document.getElementById("bocchi-stage");
	const wrapBtn = document.getElementById("bocchi-canvas-wrap");
	const tiltWrap = document.getElementById("bocchi-tilt-wrap");
	const imgEl = document.getElementById("bocchi-chibi-img") as HTMLImageElement | null;
	const bubbleEl = document.getElementById("bocchi-bubble");
	const bubbleTextEl = document.getElementById("bocchi-bubble-text");
	const hideBtn = document.getElementById("bocchi-hide-btn");
	const restoreBtn = document.getElementById("bocchi-restore-btn");
	const chipButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-bocchi-exp]"));

	const spriteMap: Record<PoseKey, string> = {
		default: root.dataset.spriteDefault || "/images/chibi/bocchi-default.webp",
		guitar: root.dataset.spriteGuitar || "/images/chibi/bocchi-guitar.webp",
		happy: root.dataset.spriteHappy || "/images/chibi/bocchi-happy.webp",
		box: root.dataset.spriteBox || "/images/chibi/bocchi-box.webp",
	};

	// Preload the other 3 lightweight sprites lazily on idle
	const preloadSprites = () => {
		Object.values(spriteMap).forEach((src) => {
			const im = new Image();
			im.src = src;
		});
	};
	const ric = (window as any).requestIdleCallback;
	if (typeof ric === "function") {
		ric(preloadSprites, { timeout: 2000 });
	} else {
		globalThis.setTimeout(preloadSprites, 1000);
	}

	let currentPose: PoseKey = "default";
	try {
		const saved = sessionStorage.getItem(POSE_STORAGE_KEY) as PoseKey | null;
		if (saved && POSE_ORDER.includes(saved)) currentPose = saved;
	} catch {}

	let isHidden = false;
	try {
		const stored = localStorage.getItem(STORAGE_KEY);
		if (stored === "1") isHidden = true;
		else if (stored === "0") isHidden = false;
		else isHidden = window.innerWidth < 1440;
	} catch {
		isHidden = window.innerWidth < 1440;
	}

	let bubbleTimer: number | undefined;
	let tempPoseTimer: number | undefined;

	function triggerHop() {
		if (!imgEl || isReducedMotion()) return;
		imgEl.classList.remove("bocchi-chibi-hop");
		void imgEl.offsetWidth;
		imgEl.classList.add("bocchi-chibi-hop");
	}

	function showBubble(text: string, duration = 3600) {
		if (!bubbleEl || !bubbleTextEl || isHidden) return;
		bubbleTextEl.textContent = text;
		bubbleEl.classList.remove("opacity-0", "translate-y-2");
		bubbleEl.classList.add("opacity-100", "translate-y-0");
		if (bubbleTimer) window.clearTimeout(bubbleTimer);
		bubbleTimer = window.setTimeout(() => {
			bubbleEl.classList.add("opacity-0", "translate-y-2");
			bubbleEl.classList.remove("opacity-100", "translate-y-0");
		}, duration);
	}

	function applyPose(pose: PoseKey, speak = true, persist = true, hop = true) {
		if (persist) {
			currentPose = pose;
			try {
				sessionStorage.setItem(POSE_STORAGE_KEY, pose);
			} catch {}
			chipButtons.forEach((btn) => {
				btn.classList.toggle("is-active", btn.dataset.bocchiExp === pose);
			});
		}
		if (imgEl && imgEl.getAttribute("src") !== spriteMap[pose]) {
			imgEl.src = spriteMap[pose];
		}
		if (hop) triggerHop();
		if (speak) {
			const pool = POSE_LINES[pose];
			showBubble(pool[Math.floor(Math.random() * pool.length)]);
		}
	}

	function flashReaction(pose: PoseKey, line: string) {
		if (isHidden) return;
		if (tempPoseTimer) window.clearTimeout(tempPoseTimer);
		applyPose(pose, false, false, true);
		showBubble(line, 3600);
		tempPoseTimer = window.setTimeout(() => {
			applyPose(currentPose, false, false, false);
		}, 3200);
	}

	function applyHiddenState(hidden: boolean, savePref = false) {
		isHidden = hidden;
		if (savePref) {
			try {
				localStorage.setItem(STORAGE_KEY, hidden ? "1" : "0");
			} catch {}
		}
		if (stage && restoreBtn) {
			stage.classList.toggle("hidden", hidden);
			restoreBtn.classList.toggle("hidden", !hidden);
			restoreBtn.classList.toggle("inline-flex", hidden);
		}
	}

	chipButtons.forEach((btn) => {
		btn.addEventListener("click", (e) => {
			e.stopPropagation();
			const pose = (btn.dataset.bocchiExp as PoseKey) || "default";
			applyPose(pose, true, true, true);
		});
	});

	wrapBtn?.addEventListener("click", () => {
		const nextIdx = (POSE_ORDER.indexOf(currentPose) + 1) % POSE_ORDER.length;
		applyPose(POSE_ORDER[nextIdx], true, true, true);
	});

	hideBtn?.addEventListener("click", (e) => {
		e.stopPropagation();
		applyHiddenState(true, true);
	});

	restoreBtn?.addEventListener("click", () => {
		applyHiddenState(false, true);
		triggerHop();
		showBubble("那、那个……我又探出头来了……");
	});

	// Subtle cursor tilt follow
	window.addEventListener(
		"pointermove",
		(e) => {
			if (e.pointerType !== "mouse" || isHidden || isReducedMotion() || !tiltWrap || !wrapBtn) return;
			const rect = wrapBtn.getBoundingClientRect();
			const cx = rect.left + rect.width * 0.5;
			const nx = Math.max(-1, Math.min(1, (e.clientX - cx) / (window.innerWidth * 0.55)));
			tiltWrap.style.transform = `translate3d(${(nx * 4).toFixed(1)}px, 0, 0) rotate(${(nx * 3.2).toFixed(2)}deg)`;
		},
		{ passive: true },
	);

	// Cross-component easter egg listeners
	window.addEventListener("bocchi:toggle", () => {
		const next = !isHidden;
		applyHiddenState(next, true);
		if (!next) {
			triggerHop();
			showBubble("被快捷键召唤出来了……！");
		}
	});

	let lastDark = document.documentElement.classList.contains("dark");
	window.addEventListener("theme:change", (e: Event) => {
		const detail = (e as CustomEvent)?.detail;
		const nowDark = typeof detail?.isDark === "boolean"
			? detail.isDark
			: document.documentElement.classList.contains("dark");
		if (nowDark === lastDark) return;
		lastDark = nowDark;
		if (nowDark) {
			flashReaction("happy", "关灯了！进入社恐舒适区……（小声欢呼）");
		} else {
			flashReaction("box", "哇啊好亮——！先钻进纸箱躲一下……");
		}
	});

	window.addEventListener("bocchi:react", (e: Event) => {
		const type = (e as CustomEvent)?.detail?.type;
		if (type === "copy-code") {
			flashReaction("happy", "代码复制好了，祝一次跑通♪");
		} else if (type === "copy-link") {
			flashReaction("happy", "链接复制好了，感谢分享！");
		} else if (type === "bottom") {
			showBubble("看到最底下了，谢谢耐心读完♪", 4000);
		}
	});

	applyPose(currentPose, false, true, false);
	applyHiddenState(isHidden, false);

	// Greet once per session
	let alreadyGreeted = false;
	try {
		alreadyGreeted = sessionStorage.getItem(GREETED_KEY) === "1";
		if (!alreadyGreeted) sessionStorage.setItem(GREETED_KEY, "1");
	} catch {}
	if (!alreadyGreeted && !isHidden) {
		window.setTimeout(() => showBubble(POSE_LINES[currentPose][0]), 700);
	}
}

initChibiBocchi();
</script>

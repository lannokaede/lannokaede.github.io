---
import { url } from "../../utils/url-utils";

const coreUrl = url("/live2d/bocchi/live2dcubismcore.min.js");
const modelUrl = url("/live2d/bocchi/bocchi.model3.json");
---

<div
	id="live2d-bocchi-root"
	class="hidden lg:block fixed left-4 min-[1480px]:left-[4.5rem] bottom-3 z-40 select-none pointer-events-none"
	data-core-url={coreUrl}
	data-model-url={modelUrl}
	aria-label="后藤一里 Live2D 看板娘"
>
	<!-- Active Live2D Stage -->
	<div id="bocchi-stage" class="bocchi-stage group relative flex flex-col items-start">
		<!-- Speech Bubble -->
		<div
			id="bocchi-bubble"
			role="status"
			aria-live="polite"
			class="bocchi-bubble pointer-events-none opacity-0 translate-y-2 transition-all duration-300 -mb-2 ml-4 max-w-[14rem] rounded-xl px-3 py-2 text-xs leading-relaxed"
		>
			<div class="flex items-center gap-1.5 mb-0.5 font-mono-tech text-[0.6rem] tracking-wider uppercase opacity-70">
				<span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
				<span>HITORI · L2D</span>
			</div>
			<p id="bocchi-bubble-text" class="text-[0.76rem] font-medium"></p>
		</div>

		<!-- WebGL Canvas Container -->
		<div
			id="bocchi-canvas-wrap"
			class="bocchi-canvas-wrap pointer-events-auto relative w-[216px] h-[256px] cursor-pointer"
			title="点击切换波奇的表情（默认 / 吉他 / 开心 / 社恐）"
		>
			<div
				id="bocchi-loading"
				class="absolute inset-x-6 bottom-6 flex items-center justify-center gap-1.5 rounded-full px-3 py-1 text-[0.68rem] font-mono-tech bocchi-dock-pill transition-opacity duration-300"
			>
				<span class="w-1.5 h-1.5 rounded-full bg-pink-400 animate-soft-pulse"></span>
				<span>LOADING BOCCHI...</span>
			</div>
		</div>

		<!-- Mini Control Dock (appears subtly, full contrast on hover) -->
		<div
			id="bocchi-dock"
			class="bocchi-dock pointer-events-auto -mt-3 ml-2 flex items-center gap-1 rounded-xl px-2 py-1 opacity-70 group-hover:opacity-100 focus-within:opacity-100 transition-all duration-200"
		>
			<span class="inline-flex items-center gap-1 pr-1 mr-0.5 border-r border-black/10 dark:border-white/10 font-mono-tech text-[0.62rem] font-semibold text-75">
				<span class="w-1.5 h-1.5 rounded-full bg-pink-400"></span>
				<span>波奇</span>
			</span>
			<button type="button" data-bocchi-exp="default" class="bocchi-chip is-active" title="默认状态">常态</button>
			<button type="button" data-bocchi-exp="guitar" class="bocchi-chip" title="拿出黑色 Les Paul 吉他">吉他</button>
			<button type="button" data-bocchi-exp="happy" class="bocchi-chip" title="开心表情">开心</button>
			<button type="button" data-bocchi-exp="scare" class="bocchi-chip" title="社恐发作">社恐</button>
			<button
				type="button"
				id="bocchi-hide-btn"
				aria-label="收起波奇看板娘"
				title="收起看板娘"
				class="ml-0.5 inline-flex items-center justify-center w-5 h-5 rounded-md text-[0.72rem] text-50 hover:text-[var(--primary)] hover:bg-black/5 dark:hover:bg-white/10 transition cursor-pointer"
			>
				×
			</button>
		</div>
	</div>

	<!-- Compact Restore Pill (shown when hidden) -->
	<button
		type="button"
		id="bocchi-restore-btn"
		class="bocchi-dock pointer-events-auto hidden items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-medium text-75 hover:text-[var(--primary)] transition-all duration-200 cursor-pointer active:scale-95"
		aria-label="展开波奇 Live2D 看板娘"
		title="召唤角落里的后藤一里"
	>
		<span class="w-2 h-2 rounded-full bg-pink-400 animate-soft-pulse"></span>
		<span class="font-mono-tech text-[0.7rem]">波奇 · L2D</span>
	</button>
</div>

<script>
type ExpKey = "default" | "guitar" | "happy" | "scare";

const STORAGE_KEY = "live2d-bocchi-hidden";
const EXP_ORDER: ExpKey[] = ["default", "guitar", "happy", "scare"];
const EXP_LINES: Record<ExpKey, string[]> = {
	default: [
		"那个……欢迎来到 lannokaede 的手记……",
		"慢慢看文章就好，不用在意角落里的我……",
		"今天也在努力写代码，没有躲进纸箱里。",
	],
	guitar: [
		"背上吉他就能稍微冷静一点……♪",
		"要听一段结束乐队的 riff 吗？（小声）",
		"音准好像没问题……应该能顺利弹完吧。",
	],
	happy: [
		"诶嘿嘿，这篇排坑记录看起来很顺利！",
		"太好了，今天也没有触发社死事件！",
		"只要把博客写完，就能稍微夸夸自己了♪",
	],
	scare: [
		"哇啊——不要突然戳我啦！！（融化中）",
		"社、社恐能量告急，请给我一个完熟芒果箱……",
		"被这么盯着看会化掉的……！",
	],
};

function loadScriptOnce(src: string): Promise<void> {
	return new Promise((resolve, reject) => {
		if ((window as any).Live2DCubismCore) {
			resolve();
			return;
		}
		const existing = document.querySelector<HTMLScriptElement>(`script[src="${src}"]`);
		if (existing) {
			if ((existing as any).__loaded) {
				resolve();
				return;
			}
			existing.addEventListener("load", () => resolve(), { once: true });
			existing.addEventListener("error", () => reject(new Error(`Failed to load ${src}`)), { once: true });
			return;
		}
		const script = document.createElement("script");
		script.src = src;
		script.async = true;
		script.onload = () => {
			(script as any).__loaded = true;
			resolve();
		};
		script.onerror = () => reject(new Error(`Failed to load ${src}`));
		document.head.appendChild(script);
	});
}

function isReducedMotion(): boolean {
	return (
		document.documentElement.classList.contains("reduce-motion") ||
		window.matchMedia("(prefers-reduced-motion: reduce)").matches
	);
}

function initBocchiWidget() {
	const root = document.getElementById("live2d-bocchi-root");
	if (!root || (window as any).__bocchiL2DInit) return;
	if (!window.matchMedia("(min-width: 1024px)").matches) return;

	(window as any).__bocchiL2DInit = true;

	const stage = document.getElementById("bocchi-stage");
	const canvasWrap = document.getElementById("bocchi-canvas-wrap");
	const loadingEl = document.getElementById("bocchi-loading");
	const bubbleEl = document.getElementById("bocchi-bubble");
	const bubbleTextEl = document.getElementById("bocchi-bubble-text");
	const hideBtn = document.getElementById("bocchi-hide-btn");
	const restoreBtn = document.getElementById("bocchi-restore-btn");
	const chipButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-bocchi-exp]"));

	const coreUrl = root.dataset.coreUrl || "/live2d/bocchi/live2dcubismcore.min.js";
	const modelUrl = root.dataset.modelUrl || "/live2d/bocchi/bocchi.model3.json";

	let currentExp: ExpKey = "default";
	let expTargets = { Guitar: 0, Happy: 0, Scare: 0 };
	let expCurrent = { Guitar: 0, Happy: 0, Scare: 0 };
	let bubbleTimer: number | undefined;
	let pixiStarted = false;
	let pixiApp: any = null;
	let isHidden = false;

	try {
		isHidden = localStorage.getItem(STORAGE_KEY) === "1";
	} catch {}

	function showBubble(text: string) {
		if (!bubbleEl || !bubbleTextEl) return;
		bubbleTextEl.textContent = text;
		bubbleEl.classList.remove("opacity-0", "translate-y-2");
		bubbleEl.classList.add("opacity-100", "translate-y-0");
		if (bubbleTimer) window.clearTimeout(bubbleTimer);
		bubbleTimer = window.setTimeout(() => {
			bubbleEl.classList.add("opacity-0", "translate-y-2");
			bubbleEl.classList.remove("opacity-100", "translate-y-0");
		}, 3800);
	}

	function setExpression(exp: ExpKey, speak = true) {
		currentExp = exp;
		expTargets = {
			Guitar: exp === "guitar" ? 1 : 0,
			Happy: exp === "happy" ? 1 : 0,
			Scare: exp === "scare" ? 1 : 0,
		};
		chipButtons.forEach((btn) => {
			btn.classList.toggle("is-active", btn.dataset.bocchiExp === exp);
		});
		if (speak) {
			const pool = EXP_LINES[exp];
			showBubble(pool[Math.floor(Math.random() * pool.length)]);
		}
	}

	function applyHiddenState(hidden: boolean) {
		isHidden = hidden;
		try {
			localStorage.setItem(STORAGE_KEY, hidden ? "1" : "0");
		} catch {}
		if (stage && restoreBtn) {
			stage.classList.toggle("hidden", hidden);
			restoreBtn.classList.toggle("hidden", !hidden);
			restoreBtn.classList.toggle("inline-flex", hidden);
		}
		if (pixiApp?.ticker) {
			if (hidden) pixiApp.ticker.stop();
			else pixiApp.ticker.start();
		}
		if (!hidden && !pixiStarted) {
			void mountLive2D();
		}
	}

	chipButtons.forEach((btn) => {
		btn.addEventListener("click", (e) => {
			e.stopPropagation();
			const exp = (btn.dataset.bocchiExp as ExpKey) || "default";
			setExpression(exp, true);
		});
	});

	canvasWrap?.addEventListener("click", () => {
		const nextIdx = (EXP_ORDER.indexOf(currentExp) + 1) % EXP_ORDER.length;
		setExpression(EXP_ORDER[nextIdx], true);
	});

	hideBtn?.addEventListener("click", (e) => {
		e.stopPropagation();
		applyHiddenState(true);
	});

	restoreBtn?.addEventListener("click", () => {
		applyHiddenState(false);
		showBubble("那、那个……我又探出头来了……");
	});

	async function mountLive2D() {
		if (pixiStarted || !canvasWrap) return;
		pixiStarted = true;

		try {
			await loadScriptOnce(coreUrl);
			if (!(window as any).Live2DCubismCore) {
				throw new Error("Live2DCubismCore unavailable");
			}

			const PIXI = await import("pixi.js");
			(window as any).PIXI = PIXI;
			const { Live2DModel } = await import("pixi-live2d-display/cubism4");
			(Live2DModel as any).registerTicker(PIXI.Ticker);

			const W = 216;
			const H = 256;
			const dpr = Math.min(window.devicePixelRatio || 1, 2);

			const app = new PIXI.Application({
				width: W,
				height: H,
				backgroundAlpha: 0,
				antialias: true,
				resolution: dpr,
				autoDensity: true,
				powerPreference: "low-power",
			});
			pixiApp = app;

			const view = app.view as HTMLCanvasElement;
			view.className = "block w-full h-full drop-shadow-[0_12px_22px_rgba(15,23,42,0.22)]";
			canvasWrap.appendChild(view);

			const model = await (Live2DModel as any).from(modelUrl, {
				autoInteract: false,
				autoUpdate: true,
			});

			const origW = model.width || 1000;
			const origH = model.height || 1000;
			// Closer upper-3/4 framing to remove empty moc3 headroom and highlight face + guitar
			const baseScale = Math.min(W / origW, H / origH);
			const scale = baseScale * 1.5;
			model.scale.set(scale);
			model.x = (W - origW * scale) / 2;
			model.y = -18;
			app.stage.addChild(model);

			if (loadingEl) {
				loadingEl.style.opacity = "0";
				window.setTimeout(() => loadingEl.remove(), 350);
			}

			// Map parameter indices once (supports both uppercase PARAM_* and camelCase Param*)
			const core = model?.internalModel?.coreModel;
			const paramIds: string[] = Array.isArray(core?._parameterIds) ? core._parameterIds : [];
			const resolveIdx = (...candidates: string[]) => {
				for (const id of candidates) {
					const idx = paramIds.indexOf(id);
					if (idx !== -1) return idx;
				}
				return -1;
			};

			const idx = {
				angleX: resolveIdx("PARAM_ANGLE_X", "ParamAngleX"),
				angleY: resolveIdx("PARAM_ANGLE_Y", "ParamAngleY"),
				angleZ: resolveIdx("PARAM_ANGLE_Z", "ParamAngleZ"),
				eyeX: resolveIdx("PARAM_EYE_BALL_X", "ParamEyeBallX"),
				eyeY: resolveIdx("PARAM_EYE_BALL_Y", "ParamEyeBallY"),
				eyeL: resolveIdx("PARAM_EYE_L_OPEN", "ParamEyeLOpen"),
				eyeR: resolveIdx("PARAM_EYE_R_OPEN", "ParamEyeROpen"),
				bodyX: resolveIdx("PARAM_BODY_ANGLE_X", "ParamBodyAngleX"),
				bodyY: resolveIdx("PARAM_BODY_ANGLE_Y", "ParamBodyAngleY"),
				bodyZ: resolveIdx("PARAM_BODY_ANGLE_Z", "ParamBodyAngleZ"),
				breath: resolveIdx("PARAM_BREATH", "ParamBreath"),
				guitar: resolveIdx("Guitar"),
				happy: resolveIdx("Happy"),
				scare: resolveIdx("Scare"),
			};

			const setByIdx = (i: number, v: number) => {
				if (i >= 0 && core) {
					try {
						core.setParameterValueByIndex(i, v);
					} catch {}
				}
			};

			// Mouse tracking + scroll reaction state
			const mouseTarget = { x: 0, y: 0 };
			const mouseCur = { x: 0, y: 0 };
			let scrollKick = 0;
			let lastScrollY = window.scrollY;

			window.addEventListener(
				"pointermove",
				(e) => {
					if (e.pointerType !== "mouse" || isHidden) return;
					const rect = canvasWrap.getBoundingClientRect();
					const cx = rect.left + rect.width * 0.5;
					const cy = rect.top + rect.height * 0.36;
					mouseTarget.x = Math.max(-1, Math.min(1, (e.clientX - cx) / (window.innerWidth * 0.45)));
					mouseTarget.y = Math.max(-1, Math.min(1, (e.clientY - cy) / (window.innerHeight * 0.45)));
				},
				{ passive: true },
			);

			window.addEventListener(
				"scroll",
				() => {
					const dy = window.scrollY - lastScrollY;
					lastScrollY = window.scrollY;
					scrollKick = Math.max(-1, Math.min(1, scrollKick + dy * 0.008));
				},
				{ passive: true },
			);

			let t = 0;
			let blinkTimer = 2.6 + Math.random() * 2.8;
			let blinkPhase = 0;
			let blinking = false;

			app.ticker.add((delta: number) => {
				if (!core || isHidden) return;
				const dt = Math.min(0.05, delta / 60);
				const reduced = isReducedMotion();

				// Smoothly blend expressions regardless of reduced-motion
				expCurrent.Guitar += (expTargets.Guitar - expCurrent.Guitar) * Math.min(1, dt * 8);
				expCurrent.Happy += (expTargets.Happy - expCurrent.Happy) * Math.min(1, dt * 8);
				expCurrent.Scare += (expTargets.Scare - expCurrent.Scare) * Math.min(1, dt * 8);
				setByIdx(idx.guitar, expCurrent.Guitar);
				setByIdx(idx.happy, expCurrent.Happy);
				setByIdx(idx.scare, expCurrent.Scare);

				if (reduced) {
					setByIdx(idx.angleX, 0);
					setByIdx(idx.angleY, 0);
					setByIdx(idx.angleZ, 0);
					setByIdx(idx.eyeL, 1);
					setByIdx(idx.eyeR, 1);
					return;
				}

				t += dt;
				mouseCur.x += (mouseTarget.x - mouseCur.x) * 0.08;
				mouseCur.y += (mouseTarget.y - mouseCur.y) * 0.08;
				scrollKick *= 0.9;

				const sway = Math.sin(t * 0.65) * 2.2;
				const nod = Math.sin(t * 1.05) * 1.4 - scrollKick * 5.5;

				setByIdx(idx.angleX, mouseCur.x * 22 + sway);
				setByIdx(idx.angleY, mouseCur.y * -16 + nod);
				setByIdx(idx.angleZ, mouseCur.x * -7 + Math.sin(t * 0.5) * 2.0);
				setByIdx(idx.eyeX, mouseCur.x * 0.85);
				setByIdx(idx.eyeY, mouseCur.y * -0.55);
				setByIdx(idx.bodyX, mouseCur.x * 6 + sway * 0.7);
				setByIdx(idx.bodyY, Math.sin(t * 1.2) * 1.8);
				setByIdx(idx.bodyZ, mouseCur.x * -3.5);
				setByIdx(idx.breath, Math.sin(t * 1.45) * 0.5 + 0.5);

				// Natural eye blink
				blinkTimer -= dt;
				if (blinkTimer <= 0 && !blinking) {
					blinking = true;
					blinkPhase = 0;
					blinkTimer = 2.8 + Math.random() * 3.6;
				}
				if (blinking) {
					blinkPhase += dt;
					let open = 1;
					if (blinkPhase < 0.085) {
						open = 1 - blinkPhase / 0.085;
					} else if (blinkPhase < 0.21) {
						open = (blinkPhase - 0.085) / 0.125;
					} else {
						open = 1;
						blinking = false;
					}
					setByIdx(idx.eyeL, open);
					setByIdx(idx.eyeR, open);
				} else {
					setByIdx(idx.eyeL, 1);
					setByIdx(idx.eyeR, 1);
				}
			});

			// Subtle greeting bubble once model is ready
			window.setTimeout(() => {
				if (!isHidden) {
					showBubble(EXP_LINES.default[0]);
				}
			}, 900);
		} catch (err) {
			console.warn("[Live2D Bocchi] Failed to initialize:", err);
			if (loadingEl) {
				loadingEl.textContent = "LIVE2D 离线";
			}
		}
	}

	applyHiddenState(isHidden);
}

// Defer slightly after initial paint so hero & main cards load first
if (document.readyState === "complete") {
	window.setTimeout(initBocchiWidget, 350);
} else {
	window.addEventListener("load", () => window.setTimeout(initBocchiWidget, 350), { once: true });
}
</script>

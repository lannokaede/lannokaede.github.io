---
import { Icon } from "astro-icon/components";
import { type NavBarLink } from "../../types/config";
import { url } from "../../utils/url-utils";

interface Props {
	links: NavBarLink[];
}

const links = Astro.props.links;
---
<div id="nav-menu-panel" class:list={["float-panel float-panel-closed absolute transition-all fixed right-4 w-52 overflow-hidden"]}>
    <div class="win-chrome">
        <div class="flex items-center gap-1.5">
            <span class="win-dots win-dots-vivid" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="font-mono-tech text-[0.64rem] text-50">~/nav</span>
        </div>
        <span class="font-mono-tech text-[0.6rem] text-50">MENU</span>
    </div>
    <div class="p-2 flex flex-col gap-0.5">
        {links.map((link) => (
            <a href={link.external ? link.url : url(link.url)}
               data-nav-path={link.external ? undefined : url(link.url)}
               class="group flex justify-between items-center py-2 pl-3 pr-2 rounded-xl gap-6
                hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)]
                aria-[current=page]:bg-[var(--btn-regular-bg)] aria-[current=page]:text-[var(--primary)] transition"
               target={link.external ? "_blank" : null}
            >
                <div class="transition text-sm text-75 font-semibold group-hover:text-[var(--primary)] group-aria-[current=page]:text-[var(--primary)]">
                    {link.name}
                </div>
                {!link.external && <Icon name="material-symbols:chevron-right-rounded"
                      class="transition text-[1.15rem] text-[var(--primary)]"
                />}
                {link.external && <Icon name="fa6-solid:arrow-up-right-from-square"
                      class="transition text-[0.72rem] text-black/30 dark:text-white/30"
                />}
            </a>
        ))}
    </div>
</div>

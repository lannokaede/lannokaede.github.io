---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { getCategoryList, getSortedPosts, getTagList } from "../../utils/content-utils";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
const [posts, categories, tags] = await Promise.all([
	getSortedPosts(),
	getCategoryList(),
	getTagList(),
]);
---
<div data-spotlight class="card-base spotlight-card overflow-hidden">
    <!-- Unified Studio Window Chrome -->
    <div class="win-chrome">
        <div class="flex items-center gap-2 min-w-0">
            <span class="win-dots text-50" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="font-mono-tech text-[0.68rem] text-50 truncate">~/profile</span>
        </div>
        <span class="inline-flex items-center gap-1.5 font-mono-tech text-[0.64rem] text-50">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-soft-pulse"></span>
            <span>UESTC · SE</span>
        </span>
    </div>

    <!-- Decorative studio gradient header band -->
    <div class="h-14 w-full relative overflow-hidden"
         style="background: linear-gradient(135deg, color-mix(in oklch, var(--primary) 28%, transparent), color-mix(in oklch, var(--primary) 8%, transparent));">
        <div class="absolute inset-0 opacity-40"
             style="background-image: radial-gradient(color-mix(in oklch, var(--primary) 45%, transparent) 1px, transparent 1px); background-size: 14px 14px;"></div>
    </div>

    <div class="px-4 pb-4 relative z-10">
        <a aria-label="Go to About Page" href={url('/about/')}
           class="group block relative mx-auto -mt-10 mb-3
           w-24 h-24 lg:w-28 lg:h-28 overflow-hidden rounded-2xl ring-4 ring-[var(--card-bg)] shadow-md active:scale-95 transition">
            <div class="absolute transition pointer-events-none group-hover:bg-black/35 group-active:bg-black/50
            w-full h-full z-50 flex items-center justify-center">
                <Icon name="fa6-regular:address-card"
                      class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-3xl">
                </Icon>
            </div>
            <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="w-full h-full transition-transform duration-300 group-hover:scale-[1.05]"></ImageWrapper>
        </a>

        <div class="px-1">
            <div class="font-display font-bold text-xl text-center mb-1 text-90 transition tracking-[-0.01em]">{config.name}</div>
            <div class="h-0.5 w-6 bg-[var(--primary)] mx-auto rounded-full mb-2.5 opacity-80 transition"></div>
            <div class="text-center text-[0.84rem] leading-relaxed text-black/60 dark:text-white/60 mb-3.5 transition">{config.bio}</div>

            <div class="grid grid-cols-3 gap-1.5 py-2.5 mb-3.5 border-y border-dashed border-[var(--line-divider)] text-center">
                <a href={url('/archive/')} class="rounded-xl py-1.5 hover:bg-[var(--btn-plain-bg-hover)] transition">
                    <div class="font-mono-tech text-base font-bold text-90 leading-tight">{posts.length}</div>
                    <div class="text-[0.7rem] text-50 mt-0.5">文章</div>
                </a>
                <a href={url('/archive/')} class="rounded-xl py-1.5 hover:bg-[var(--btn-plain-bg-hover)] transition">
                    <div class="font-mono-tech text-base font-bold text-90 leading-tight">{categories.length}</div>
                    <div class="text-[0.7rem] text-50 mt-0.5">分类</div>
                </a>
                <a href={url('/archive/')} class="rounded-xl py-1.5 hover:bg-[var(--btn-plain-bg-hover)] transition">
                    <div class="font-mono-tech text-base font-bold text-90 leading-tight">{tags.length}</div>
                    <div class="text-[0.7rem] text-50 mt-0.5">标签</div>
                </a>
            </div>

            <!-- Proposal C: Dark Mini Terminal Console (interactive) -->
            <button type="button" id="now-terminal-btn" title="点击切换状态"
                    class="mini-terminal group w-full text-left mb-4 rounded-xl overflow-hidden active:scale-[0.98] cursor-pointer">
                <div class="px-2.5 py-1.5 flex items-center justify-between border-b border-white/10"
                     style="background: rgba(255, 255, 255, 0.04);">
                    <div class="flex items-center gap-1.5 min-w-0">
                        <span class="win-dots win-dots-vivid" aria-hidden="true"><span></span><span></span><span></span></span>
                        <span class="font-mono-tech text-[0.64rem] text-slate-400 truncate">lannokaede@cd:~</span>
                    </div>
                    <span class="shrink-0 font-mono-tech text-[0.62rem] text-[var(--primary)] opacity-80 group-hover:opacity-100 transition">TAB ↻</span>
                </div>
                <div class="px-2.5 py-2.5 font-mono-tech term-scanlines">
                    <div class="text-[0.65rem] text-emerald-400/90 mb-1 flex items-center gap-1.5">
                        <span>$ status --mode</span>
                        <span id="now-terminal-label" class="px-1.5 py-0.2 rounded text-[0.62rem]"
                              style="background-color: color-mix(in oklch, var(--primary) 26%, transparent); color: color-mix(in oklch, var(--primary) 45%, white);">build</span>
                    </div>
                    <div class="text-[0.75rem] text-slate-100 truncate">
                        <span class="text-[var(--primary)] mr-1">❯</span><span id="now-terminal-text">Go Agent · LibreChat · VPS</span><span class="terminal-cursor" aria-hidden="true"></span>
                    </div>
                </div>
            </button>

            <div class="flex flex-wrap gap-2 justify-center">
                {config.links.length > 1 && config.links.map(item =>
                        <a rel="me" data-magnetic title={item.name} aria-label={item.name} href={item.url} target="_blank" class="btn-regular rounded-xl h-9 w-9 active:scale-90">
                            <Icon name={item.icon} class="text-[1.2rem]"></Icon>
                        </a>
                )}
                {config.links.length == 1 && <a rel="me" data-magnetic title={config.links[0].name} aria-label={config.links[0].name} href={config.links[0].url} target="_blank"
                                                class="btn-regular rounded-xl h-9 gap-2 px-3 font-bold active:scale-95">
                    <Icon name={config.links[0].icon} class="text-[1.2rem]"></Icon>
                    {config.links[0].name}
                </a>}
            </div>
        </div>
    </div>
</div>

---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center rounded-2xl overflow-hidden transition" onclick="backToTop()">
        <button data-magnetic aria-label="Back to Top" class="card-base hover:border-[var(--primary)] relative h-[3.5rem] w-[3.5rem] rounded-2xl flex items-center justify-center group active:scale-90 transition">
            <svg class="absolute inset-0 w-full h-full -rotate-90 pointer-events-none" viewBox="0 0 56 56" aria-hidden="true">
                <circle cx="28" cy="28" r="22" fill="none" stroke="currentColor" stroke-width="2.2" class="text-black/10 dark:text-white/10" />
                <circle id="back-to-top-ring" cx="28" cy="28" r="22" fill="none" stroke="var(--primary)" stroke-width="2.4" stroke-linecap="round"
                        stroke-dasharray="138.23" stroke-dashoffset="138.23" style="transition: stroke-dashoffset 80ms linear;" />
            </svg>
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="relative z-10 text-[1.75rem] text-[var(--primary)] transition-transform group-hover:-translate-y-0.5"></Icon>
        </button>
    </div>
</div>

<style lang="stylus">
.back-to-top-wrapper
    width: 3.5rem
    height: 3.5rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none

.back-to-top-btn
    color: var(--primary)
    border: none
    position: fixed
    bottom: 6rem
    opacity: 1
    cursor: pointer
    transform: translateX(4.75rem)
    pointer-events: auto
    &.hide
        transform: translateX(4.75rem) scale(0.85) translateY(8px)
        opacity: 0
        pointer-events: none
    &:active
      transform: translateX(4.75rem) scale(0.92)

</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
</script>

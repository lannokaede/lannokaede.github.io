---
interface Props {
	size?: string;
	dot?: boolean;
	href?: string;
	label?: string;
}
const { href, label }: Props = Astro.props;
---
<a href={href} aria-label={label} class="pill-tag">
    <span class="pill-tag-prefix" aria-hidden="true">#</span><span class="pill-tag-label"><slot></slot></span>
</a>

---
interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---
<a href={url} aria-label={label}
   class="group flex items-center justify-between w-full h-9 rounded-xl px-2.5
          text-sm text-75 hover:text-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)]
          transition-all duration-200">
    <span class="flex items-center gap-2 min-w-0">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)] opacity-45 group-hover:opacity-100 group-hover:scale-125 transition"></span>
        <span class="truncate group-hover:translate-x-0.5 transition-transform">
            <slot></slot>
        </span>
    </span>
    { badge !== undefined && badge !== null && badge !== '' &&
        <span class="shrink-0 ml-3 px-2 py-0.5 rounded-full font-mono-tech text-[0.72rem] font-semibold transition"
              style="background-color: color-mix(in oklch, var(--primary) 12%, transparent); color: var(--btn-content);">
            { badge }
        </span>
    }
</a>

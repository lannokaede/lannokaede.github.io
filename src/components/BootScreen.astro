---
import FieldEmblem from "./FieldEmblem.astro";
---
<div id="field-boot" hidden role="dialog" aria-modal="true" aria-label="正在进入博客">
  <div class="boot-track"><div id="boot-fill"></div></div>
  <div class="boot-brand"><FieldEmblem id="boot" /><span>lannokaede</span><small>保持好奇，持续折腾</small></div>
  <div id="boot-readout"><strong id="boot-percent">0%</strong><span id="boot-status">INITIALIZING</span></div>
  <button id="boot-skip" type="button">跳过 / SKIP ↗</button>
  <div class="boot-sweep"></div>
</div>
<script is:inline>
(() => {
  const cover = document.getElementById('field-boot');
  if (!cover || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  try { if (sessionStorage.getItem('field-boot-seen')) return; sessionStorage.setItem('field-boot-seen', '1'); } catch {}
  cover.hidden = false;
  const previousOverflow = document.documentElement.style.overflow;
  document.documentElement.style.overflow = 'hidden';
  const started = performance.now();
  let frame, finished = false, exiting = false;
  const finish = () => {
    if (finished) return;
    finished = true;
    cancelAnimationFrame(frame);
    cover.hidden = true;
    document.documentElement.style.overflow = previousOverflow;
    if (cover.contains(document.activeElement)) document.activeElement.blur();
  };
  document.getElementById('boot-skip').onclick = finish;
  const escape = (event) => { if (event.key === 'Escape') finish(); };
  document.addEventListener('keydown', escape);
  const timeout = setTimeout(finish, 5000);
  const tick = (now) => {
    if (finished || exiting) return;
    const elapsed = now - started;
    const ready = document.readyState === 'complete' || elapsed > 3000;
    const progress = Math.floor(Math.min(ready ? 100 : 92, elapsed / 900 * 100));
    cover.style.setProperty('--boot-progress', progress + '%');
    document.getElementById('boot-percent').textContent = progress + '%';
    document.getElementById('boot-status').textContent = progress === 100 ? 'READY' : 'LOADING';
    if (progress === 100) {
      exiting = true;
      setTimeout(() => { if (!finished) { cover.classList.add('boot-exit'); document.getElementById('boot-status').textContent = 'WELCOME'; } }, 120);
      setTimeout(() => { finish(); clearTimeout(timeout); document.removeEventListener('keydown', escape); }, 850);
    } else frame = requestAnimationFrame(tick);
  };
  frame = requestAnimationFrame(tick);
})();
</script>
<style is:global>
#field-boot[hidden]{display:none}
#field-boot{position:fixed;inset:0;z-index:100000;background:var(--page-bg);color:var(--field-ink);overflow:hidden;font-family:inherit;animation:boot-failsafe 0s 5.1s forwards}
.boot-track{position:absolute;inset:auto 0 0;height:2px;background:var(--field-rule)}
#boot-fill{width:var(--boot-progress,0%);height:100%;background:var(--field-signal)}
.boot-brand{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;align-items:center;flex-direction:column;gap:18px;width:max-content;color:var(--field-ink)}
.boot-brand svg{width:80px;height:80px;color:var(--field-signal)}
.boot-brand>span{font-size:28px;letter-spacing:-.04em;font-weight:500}
.boot-brand small{font-size:12px;color:var(--field-muted)}
#boot-readout{position:absolute;left:24px;bottom:24px;display:flex;align-items:center;gap:12px;color:var(--field-muted)}
#boot-percent{font-size:12px;font-weight:400;font-variant-numeric:tabular-nums}
#boot-status{font-size:10px;letter-spacing:.08em}
#boot-skip{position:absolute;right:24px;top:24px;padding:12px;color:var(--field-muted);font-size:11px;z-index:3}
#boot-skip:focus-visible{outline:2px solid var(--primary)}
.boot-sweep{display:none}
.boot-exit{transition:opacity .35s;opacity:0;pointer-events:none}
@keyframes boot-failsafe{to{visibility:hidden;pointer-events:none}}
@media(prefers-reduced-motion:reduce){#field-boot{display:none!important}}
</style>

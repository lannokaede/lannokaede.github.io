---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getDir, getTagUrl } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
	featured?: boolean;
	issueNumber?: string;
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	style,
	featured = false,
	issueNumber = "01",
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";
const visibleTags = (tags || []).slice(0, featured ? 5 : 3);

const { remarkPluginFrontmatter } = await entry.render();
---
{featured ? (
<article data-spotlight data-tilt data-reveal class:list={["card-base post-card spotlight-card tilt-card scroll-reveal flex flex-col w-full rounded-[var(--radius-large)] overflow-hidden relative", className]} style={style}>
    <span class="corner-tick top-2 left-2 border-t-2 border-l-2 rounded-tl -translate-x-1 -translate-y-1" aria-hidden="true"></span>
    <span class="corner-tick top-2 right-2 border-t-2 border-r-2 rounded-tr translate-x-1 -translate-y-1" aria-hidden="true"></span>
    <span class="corner-tick bottom-2 left-2 border-b-2 border-l-2 rounded-bl -translate-x-1 translate-y-1" aria-hidden="true"></span>
    <span class="corner-tick bottom-2 right-2 border-b-2 border-r-2 rounded-br translate-x-1 translate-y-1" aria-hidden="true"></span>
    <div class="win-chrome">
        <div class="flex items-center gap-2 min-w-0">
            <span class="win-dots text-50" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="font-mono-tech text-[0.68rem] text-50 truncate">~/posts/{entry.slug}.md</span>
        </div>
        <span class="font-mono-tech text-[0.66rem] text-[var(--primary)] font-semibold shrink-0">LATEST · #{issueNumber}</span>
    </div>
    {hasCover && (
        <a href={url} aria-label={title} class="group cover-sheen relative block w-full aspect-[16/9] md:aspect-[21/9] overflow-hidden">
            <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt="Cover Image of the Post"
                          class="w-full h-full transition-transform duration-700 ease-out group-hover:scale-[1.05]">
            </ImageWrapper>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/65 via-black/10 to-black/15"></div>
            <div class="absolute top-3.5 left-4 z-20 inline-flex items-center gap-2 rounded-full px-3 py-1 text-[0.7rem] font-mono-tech font-semibold tracking-wider text-white bg-black/50 backdrop-blur-md border border-white/20">
                <span class="eq-bars" aria-hidden="true">
                    <span></span><span></span><span></span>
                </span>
                <span>LATEST · #{issueNumber}</span>
            </div>
            {category && (
                <div class="absolute top-3.5 right-4 z-20 rounded-full px-3 py-1 text-xs font-medium text-white/95 bg-black/45 backdrop-blur-md border border-white/15">
                    {category}
                </div>
            )}
            <!-- subtle decorative corner reticle -->
            <span class="pointer-events-none hidden md:block absolute bottom-3 right-4 z-20 font-mono-tech text-[0.65rem] tracking-widest text-white/60">
                FIELD NOTE // {formatDateToYYYYMMDD(published)}
            </span>
        </a>
    )}

    <div class="px-5 md:px-8 pt-5 md:pt-6 pb-6 relative z-10">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs font-mono-tech text-50 mb-2.5">
            <span class="inline-flex items-center gap-1">
                <Icon name="material-symbols:calendar-today-outline-rounded" class="text-sm text-[var(--primary)]" />
                {formatDateToYYYYMMDD(published)}
            </span>
            <span aria-hidden="true" class="text-25">/</span>
            <span class="inline-flex items-center gap-1">
                <Icon name="material-symbols:notes-rounded" class="text-sm text-[var(--primary)]" />
                {remarkPluginFrontmatter.words} {i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
            </span>
            <span aria-hidden="true" class="text-25">/</span>
            <span class="inline-flex items-center gap-1">
                <Icon name="material-symbols:schedule-outline-rounded" class="text-sm text-[var(--primary)]" />
                {remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
            </span>
        </div>

        <a href={url}
           class="group block font-display font-bold text-2xl md:text-[1.7rem] leading-snug tracking-[-0.015em] text-90 hover:text-[var(--primary)] transition mb-2.5">
            <span>{title}</span>
        </a>

        <p class="text-[0.95rem] leading-relaxed text-75 mb-4 line-clamp-3">
            {description || remarkPluginFrontmatter.excerpt}
        </p>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-3.5 border-t border-dashed border-[var(--line-divider)]">
            <div class="flex flex-wrap items-center gap-1.5">
                {visibleTags.map((tag) => (
                    <a href={getTagUrl(tag)} class="pill-tag">#{tag.trim()}</a>
                ))}
            </div>
            <a href={url} class="group inline-flex items-center gap-1 text-xs font-semibold text-[var(--primary)] hover:opacity-80 transition">
                <span>阅读全文</span>
                <Icon name="material-symbols:arrow-forward-rounded" class="text-base transition-transform duration-200 group-hover:translate-x-1" />
            </a>
        </div>
    </div>
</article>
) : (
<article data-spotlight data-tilt data-reveal class:list={["card-base post-card spotlight-card tilt-card scroll-reveal flex flex-col h-full w-full rounded-[var(--radius-large)] overflow-hidden relative", className]} style={style}>
    <span class="corner-tick top-2 left-2 border-t-2 border-l-2 rounded-tl -translate-x-1 -translate-y-1" aria-hidden="true"></span>
    <span class="corner-tick top-2 right-2 border-t-2 border-r-2 rounded-tr translate-x-1 -translate-y-1" aria-hidden="true"></span>
    <span class="corner-tick bottom-2 left-2 border-b-2 border-l-2 rounded-bl -translate-x-1 translate-y-1" aria-hidden="true"></span>
    <span class="corner-tick bottom-2 right-2 border-b-2 border-r-2 rounded-br translate-x-1 translate-y-1" aria-hidden="true"></span>
    <div class="win-chrome">
        <div class="flex items-center gap-2 min-w-0">
            <span class="win-dots text-50" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="font-mono-tech text-[0.66rem] text-50 truncate">#{issueNumber} · {category || "notes"}</span>
        </div>
        <span class="font-mono-tech text-[0.65rem] text-50 shrink-0">{formatDateToYYYYMMDD(published)}</span>
    </div>
    {hasCover && (
        <div class="group cover-sheen relative w-full aspect-[16/10] overflow-hidden">
            <a href={url} aria-label={title} class="block w-full h-full">
                <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt="Cover Image of the Post"
                              class="w-full h-full transition-transform duration-700 ease-out group-hover:scale-[1.06]">
                </ImageWrapper>
            </a>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-black/5 to-black/15"></div>
            <div class="pointer-events-none absolute top-3 left-3 z-20 px-2.5 py-0.5 rounded-full font-mono-tech text-[0.68rem] font-semibold text-white bg-black/50 backdrop-blur-md border border-white/15">
                #{issueNumber}
            </div>
            {category && (
                <a href={getCategoryUrl(category)} class="absolute top-3 right-3 z-20 px-2.5 py-0.5 rounded-full text-[0.72rem] font-medium text-white/95 bg-black/45 backdrop-blur-md border border-white/15 hover:bg-[var(--primary)] transition">
                    {category}
                </a>
            )}
            <div class="pointer-events-none absolute bottom-2.5 right-3 z-20 opacity-0 translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition duration-300 w-7 h-7 rounded-full bg-black/50 backdrop-blur-md border border-white/20 flex items-center justify-center text-white">
                <Icon name="material-symbols:arrow-outward-rounded" class="text-base" />
            </div>
        </div>
    )}

    <div class="flex flex-col flex-1 p-5 relative z-10">
        <div class="flex items-center justify-between gap-2 text-[0.74rem] font-mono-tech text-50 mb-2">
            <span>{formatDateToYYYYMMDD(published)}</span>
            <span>{remarkPluginFrontmatter.words} 字 · {remarkPluginFrontmatter.minutes} 分钟</span>
        </div>

        <a href={url}
           class="group block font-display font-bold mb-2 text-[1.16rem] leading-snug tracking-[-0.01em] text-90 hover:text-[var(--primary)] transition line-clamp-2">
            <span>{title}</span>
        </a>

        <p class="text-[0.88rem] leading-relaxed text-75 mb-4 line-clamp-2">
            {description || remarkPluginFrontmatter.excerpt}
        </p>

        <div class="mt-auto pt-3 border-t border-dashed border-[var(--line-divider)] flex items-center justify-between gap-2">
            <div class="flex flex-wrap items-center gap-1.5 min-w-0">
                {visibleTags.map((tag) => (
                    <a href={getTagUrl(tag)} class="pill-tag">#{tag.trim()}</a>
                ))}
            </div>
            <a href={url} aria-label={title} class="shrink-0 text-[var(--primary)] hover:translate-x-0.5 transition">
                <Icon name="material-symbols:arrow-forward-rounded" class="text-lg" />
            </a>
        </div>
    </div>
</article>
)}
